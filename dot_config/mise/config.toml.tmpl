# mise global config — managed by chezmoi
# Shared: language runtimes with per-project version sensitivity.
# Per-machine: WSL uses mise for the full toolchain (no Homebrew there);
# Mac uses mise only for languages + npm globals — everything else is Homebrew.
[settings]
# Precompiled pythons only (python-build-standalone). Source builds break on
# brand-new macOS SDKs (e.g. unguarded pipe2 on SDK 26.x) and need no toolchain;
# "latest" then resolves to the newest *precompiled* release.
python.compile = false
# Install pipx-backend tools (ansible, git-filter-repo) via `uv tool` (uvx), not pipx: pipx's
# hand-off to uv throws a fatal uv error on this box, while `uv tool install`
# works directly. (uvx uses the `uv` tool, already pinned in [tools] below.)
pipx.uvx = true

[tools]
# Categories below are the `# --- ... ---` headers; gen-tools.py reads them to
# group TOOLS.md, so a new tool belongs under one of them. The vocabulary is
# shared with the Brewfile so both machines document alike.

{{ if ne .machine "linux-minimal" -}}
# --- Languages + runtimes ---
node      = "lts"
python    = "latest"
terraform = "latest"

# --- Containers + registries ---
# regctl is SHARED (mac exception to the brew-first rule, agreed 2026-07-07): homebrew-core
# has no formula and regclient's official tap is an empty stub, so a junior/tap formula
# would mean manual version bumps forever. mise's registry auto-tracks upstream's official
# release binaries. If a real homebrew-core formula ever appears, move the mac to the Brewfile.
regctl    = "latest"

# --- Kubernetes / cloud-native ---
# k10s is SHARED for the same reason as regctl: no homebrew-core formula, no
# upstream tap and nothing in mise's registry, so the github backend takes the
# release binary on both machines. PINNED, unlike its neighbours: a young
# project with one maintainer and unsigned releases, so a new version waits
# until someone has read it. Its own updater is switched off in
# ~/.k10s/config.yaml, so mise stays the only thing that replaces the binary.
# Leave its AI feature unconfigured on work machines: it sends the current
# context and namespace names to the provider.
"github:p10node/k10s" = "0.1.6"

{{ end -}}

{{ if eq .machine "wsl-work" -}}
# === wsl-work: full mise-managed toolchain (no Homebrew on this box) ===

# --- Languages + runtimes ---
go        = "latest"

# --- Containers + registries ---
# Real docker CLI (client only) — talks to rootless podman's Docker-compatible
# API socket (DOCKER_HOST in .zshrc; socket enabled by run_onchange_setup-docker-cli).
docker-cli = "latest"

# --- Kubernetes / cloud-native ---
cosign    = "latest"
helm      = "latest"
istioctl  = "latest"
k3d       = "latest"
k9s       = "latest"
kind      = "latest"
kubecolor = "latest"
kubectl   = "latest"
kubectx   = "latest"
kubens    = "latest"
kustomize = "latest"
stern     = "latest"
# Not in mise's registry — the github backend pulls release assets directly.
"github:falcosecurity/falcoctl"          = "latest"
"github:kubernetes-sigs/ingress2gateway" = "latest"
"github:kubeshark/kubeshark"             = "latest"
"github:operator-framework/operator-sdk" = "latest"
"github:projectcalico/calico"            = "latest"

# --- Dev utilities ---
ansible   = "latest"
bat       = "latest"
chezmoi   = "latest"
delta     = "latest"
direnv    = "latest"
eza       = "latest"
fd        = "latest"
fx        = "latest"
fzf       = "latest"
git-filter-repo = "latest"
glab      = "latest"
grpcurl   = "latest"
jq        = "latest"
lazygit   = "latest"
lnav      = "latest"
pipx      = "latest"
ripgrep   = "latest"
uv        = "latest"
yq        = "latest"
zoxide    = "latest"
# skilla: mise here only — the Mac gets it from Homebrew (junior/tap/skilla).
"github:junior/skilla" = { version = "0.3.0", exe = "skilla", matching = "skilla" }
"npm:@vscode/vsce"                       = "latest"
"npm:snyk"                               = "latest"

# bpftool is NOT here: upstream tarballs ship the binary without an exec bit,
# which defeats mise's bin detection — run_onchange_install-ebpf-tools.sh
# installs it to /usr/local/bin instead (sudo-friendly for a root-only tool).
#
# Employer-specific tools (e.g. internal artifact CLIs) are NOT here — they
# come from the private overlay via ~/.config/mise/conf.d/*.toml, which mise
# merges automatically.
{{- end }}

{{ if eq .machine "mac-personal" -}}
# === mac-personal: opentofu + npm globals (languages above; rest via Homebrew) ===

# --- Languages + runtimes ---
opentofu = "latest"

# --- Dev utilities ---
"npm:fantasticon" = "latest"

# Java/JDK lives here when needed (uncomment + adjust version):
# java = "temurin-21"
{{- if eq .chezmoi.arch "amd64" }}

# --- Dev utilities ---
# INTEL ONLY. Homebrew stopped building Intel bottles in September 2026
# (decision 0006 in the vault) and uv needs the Rust toolchain, so LLVM first.
# Upstream ships an Intel Mac binary, which is what mise fetches here. mise
# itself arrives the same way, from run_install-mise-intel-mac.sh. On Apple
# silicon uv stays in the Brewfile and this does not render.
uv        = "latest"
{{- end }}
{{- end }}

{{ if eq .machine "linux-minimal" -}}
{{- $extras := list -}}{{- if hasKey . "extras" -}}{{- $extras = regexSplit "\\s*,\\s*" (trim .extras) -1 -}}{{- end -}}
# === linux-minimal: a host where you cannot install packages ===
# Every entry is a single static binary, so none of it needs a runtime or root.
# The one exception is opt-in: the "python" extra, further down.

# --- Kubernetes / cloud-native ---
# kubectl and helm are deliberately absent. Where a host already ships them they
# are usually matched to its clusters by whoever builds it, and a mise shim would
# silently shadow that. On a host that has neither, add them yourself:
#   mise use -g kubectl@1.34 helm@latest
k9s       = "latest"
kubecolor = "latest"   # `k` is kubecolor when present, kubectl otherwise
stern     = "latest"
kubectx   = "latest"
kubens    = "latest"
kustomize = "latest"

# --- Dev utilities ---
# Search and navigation: the difference between a bare login and a workstation.
eza       = "latest"   # ls with colour, icons and git status; ls/ll/la/lt alias to it
fzf       = "latest"   # Ctrl-R over history, Ctrl-T over files
fd        = "latest"   # what Ctrl-T walks
ripgrep   = "latest"
zoxide    = "latest"
bat       = "latest"
jq        = "latest"
yq        = "latest"
{{- if has "python" $extras }}
uv        = "latest"   # uv run script.py: a script with its own dependencies, no venv to keep

# --- Languages + runtimes ---
# Only with the "python" extra, for the same reason kubectl is absent above: mise's
# shims lead PATH, so `python3`, `pip` and `#!/usr/bin/env python3` become this
# build for you. The host's own stays at /usr/bin/python3, which is what the
# distro's packaged tools call. Enterprise distros ship a python3 years out of
# support (3.6 on EL8), so scripts written today do not even parse there.
# Precompiled (python.compile = false above): no compiler, no root, about 110 MB.
python    = "latest"
{{- end }}
{{- end }}
