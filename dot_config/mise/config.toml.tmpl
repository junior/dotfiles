{{- /* A machine's own packages (README, "Work overlay"): ~/.config/dotfiles/packages.toml
       may skip or replace tools below; a replaced one is left out, and the overlay's
       ~/.config/mise/conf.d declares the new one. The packages-filter template applies
       this to the file's own text, which it gets by rendering this file again with
       packages_raw set. With no such file the output is the config exactly as written.
       That second pass reads the file from the source directory, so rendering a copy
       over stdin needs --source pointing at the copy's tree. */ -}}
{{- if not (hasKey . "packages_raw") -}}
{{-   includeTemplate "packages-filter" (dict "file" "dot_config/mise/config.toml.tmpl" "format" "mise" "data" .) | trimSuffix "\n" -}}
{{- else -}}
{{- /* An appliance (role appliance, mac-personal) gets no tools from here, only the
       settings: what one appliance needs goes in its ~/.config/mise/conf.d/. */ -}}
{{- $appliance := false -}}{{- if hasKey . "roles" }}{{ $appliance = has "appliance" .roles }}{{ end -}}
# mise global config — managed by chezmoi
# Shared: language runtimes with per-project version sensitivity.
# Per-machine: WSL uses mise for the full toolchain (no Homebrew there);
# an Apple-silicon Mac uses mise only for languages + npm globals — everything
# else is Homebrew. An Intel Mac also takes its command-line tools from mise
# (the Intel block below): Homebrew builds no Intel bottles.
[settings]
# Precompiled pythons only (python-build-standalone). Source builds break on
# brand-new macOS SDKs (e.g. unguarded pipe2 on SDK 26.x) and need no toolchain;
# "latest" then resolves to the newest *precompiled* release.
python.compile = false
# Install pipx-backend tools (ansible, git-filter-repo) via `uv tool` (uvx), not pipx: pipx's
# hand-off to uv throws a fatal uv error on this box, while `uv tool install`
# works directly. (uvx uses the `uv` tool, already pinned in [tools] below.)
pipx.uvx = true
# mise hides a release younger than its minimum release age (a supply-chain guard),
# so the maintainer's own kcx spent the day after each release unresolvable as
# "latest", and `up` warned "no latest version found". The maintainer's own tool is exempt.
minimum_release_age_excludes = ["github:junior/kcx"]

[tools]
# Categories below are the `# --- ... ---` headers; gen-tools.py reads them to
# group TOOLS.md, so a new tool belongs under one of them. The vocabulary is
# shared with the Brewfile so both machines document alike.

{{ if and (ne .machine "linux-minimal") (not $appliance) -}}
# --- Languages + runtimes ---
node      = "lts"
python    = "latest"
terraform = "latest"

# --- Containers + registries ---
# regctl is SHARED (mac exception to the brew-first rule, agreed 2026-07-07): homebrew-core
# has no formula and regclient's official tap is an empty stub, so a junior/tap formula
# would mean manual version bumps forever. mise's registry auto-tracks upstream's official
# release binaries. If a real homebrew-core formula ever appears, move the mac to the Brewfile.
regctl    = "latest"

# --- Kubernetes / cloud-native ---
# k10s is SHARED for the same reason as regctl: no homebrew-core formula, no
# upstream tap and nothing in mise's registry, so the github backend takes the
# release binary on both machines. Like its neighbours it follows the latest
# release, so every `up` brings a new one. Its startup update check is off in
# ~/.k10s/config.yaml, so only mise, or an explicit `k10s update`, replaces it.
# Leave its AI feature unconfigured on work machines: it sends the current
# context and namespace names to the provider.
"github:p10node/k10s" = "latest"

{{ end -}}

