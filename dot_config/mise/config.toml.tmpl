{{ if eq .machine "linux-minimal" -}}
{{- $extras := list -}}{{- if hasKey . "extras" -}}{{- $extras = regexSplit "\\s*,\\s*" (trim .extras) -1 -}}{{- end -}}
# === linux-minimal: a host where you cannot install packages ===
# Every entry is a single static binary, so none of it needs a runtime or root.
# The one exception is opt-in: the "python" extra, further down.

# --- Kubernetes / cloud-native ---
# kubectl and helm are deliberately absent. Where a host already ships them they
# are usually matched to its clusters by whoever builds it, and a mise shim would
# silently shadow that. On a host that has neither, add them yourself:
#   mise use -g kubectl@1.34 helm@latest
k9s       = "latest"
kubecolor = "latest"   # `k` is kubecolor when present, kubectl otherwise
stern     = "latest"
kustomize = "latest"
# kcx, the maintainer's kubeconfig tool (contexts, namespaces, one file per cluster,
# a read-only shell), a static binary from its GitHub release, in place of kubectx
# and kubens; mise verifies the release's attestation, and "latest" resolves at
# once thanks to the exemption in [settings].
"github:junior/kcx" = "latest"
# k10s, a Kubernetes terminal UI you can click: a static binary from its GitHub
# release, whose attestation mise verifies (k10s publishes one since 0.1.8). Its
# startup update check is off in ~/.k10s/config.yaml, so only mise, or an explicit
# `k10s update`, replaces the binary. Its AI feature is off in the 0.1.8 build; if it
# returns, leave it unconfigured on work hosts: it sends the current context and
# namespace names to the provider. `k10s --readonly` refuses every request that
# could change the cluster.
"github:p10node/k10s" = "latest"

# --- Dev utilities ---
# Search and navigation: the difference between a bare login and a workstation.
eza       = "latest"   # ls with colour, icons and git status; ls/ll/la/lt alias to it
fzf       = "latest"   # Ctrl-R over history, Ctrl-T over files
fd        = "latest"   # what Ctrl-T walks
ripgrep   = "latest"
zoxide    = "latest"
bat       = "latest"
jq        = "latest"
yq        = "latest"
{{- if has "python" $extras }}
uv        = "latest"   # uv run script.py: a script with its own dependencies, no venv to keep

# --- Languages + runtimes ---
# Only with the "python" extra, for the same reason kubectl is absent above: mise's
# shims lead PATH, so `python3`, `pip` and `#!/usr/bin/env python3` become this
# build for you. The host's own stays at /usr/bin/python3, which is what the
# distro's packaged tools call. Enterprise distros ship a python3 years out of
# support (3.6 on EL8), so scripts written today do not even parse there.
# Precompiled (python.compile = false above): no compiler, no root, about 110 MB.
python    = "latest"
{{- end }}
{{- if or (has "codex" $extras) (has "opencode" $extras) }}

# --- AI / agents ---
# Coding agents, each its own extra. Claude Code and the Devin CLI are extras too,
# but their own installers keep them current, so they are run_ scripts, not mise
# tools. Signing in is yours, and each keeps its login under your home, which root
# can read on a shared host.
{{- end }}
{{- if has "codex" $extras }}
# "codex": OpenAI's Codex CLI, the statically linked musl build from its GitHub
# releases, about 430 MB installed. Sign in with `codex login --device-auth` where
# there is no browser.
codex     = "latest"
{{- end }}
{{- if has "opencode" $extras }}
# "opencode": the opencode CLI, about 190 MB. From its GitHub releases directly:
# mise's registry entry lists a 2.0.x the project never released (2026-10-13), so
# its "latest" fails to install. The glibc "baseline" build, because the musl ones
# are linked against musl, whose loader a glibc host lacks, and baseline needs no
# AVX2, which some virtual CPUs hide. Sign in with `opencode auth login`.
"github:anomalyco/opencode" = { version = "latest", asset_pattern = "opencode-linux-{{ if eq .chezmoi.arch "arm64" }}arm64{{ else }}x64-baseline{{ end }}.tar.gz" }
{{- end }}
{{- end }}
{{- end }}
