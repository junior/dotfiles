# kind cluster, bring-your-own CNI: 1 control-plane + 2 workers, no default
# CNI and no CNI-specific settings (kind's default podSubnet 10.244.0.0/16).
# For Cilium and other CNIs under test; for Calico use calico-iptables.yaml
# or calico-ebpf.yaml instead. Nodes stay NotReady until a CNI is installed.
# Create (wsl-work: rkind / mac-personal: kind):
#   kind create cluster --config ~/.config/kind/no-cni.yaml
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  disableDefaultCNI: true
nodes:
{{- if eq .machine "wsl-work" }}
# Corporate TLS-intercepting proxy: mount the host's system trust bundle over
# each node's bundle so containerd/kubelet trust the corporate CA. Nodes never
# run update-ca-certificates, so the bundle is mounted in directly.
- role: control-plane
  extraMounts: &ca-mounts
  - hostPath: /etc/ssl/certs/ca-certificates.crt
    containerPath: /etc/ssl/certs/ca-certificates.crt
    readOnly: true
- role: worker
  extraMounts: *ca-mounts
- role: worker
  extraMounts: *ca-mounts
{{- else }}
- role: control-plane
- role: worker
- role: worker
{{- end }}
