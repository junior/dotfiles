# Brewfile (mac-personal, role appliance) - apply with `brew bundle --global`
#
# An APPLIANCE runs one service (a VM host, a box for one assistant), is reached
# over ssh, and holds no credentials and no agent sessions. Its packages are an
# ALLOW-LIST, the opposite of the lab node's deny-list: nothing added to the desktop
# list reaches it, so an appliance changes only when someone changes this list. No
# taps, no GUI casks, no cloud CLIs, no gh (no credentials to use it with), no
# 1Password, no coding agents, no Docker. The one tool a single appliance needs goes
# in its own ~/.Brewfile.local.

# --- Shell + completions ---
brew "powerlevel10k"
brew "zsh"
brew "zsh-autosuggestions"
brew "zsh-completions"
brew "zsh-history-substring-search"
brew "zsh-syntax-highlighting"

# --- Dev utilities ---
brew "bat"         # ~/.zshrc's cat alias and MANPAGER
brew "chezmoi"
brew "eza"         # ~/.zshrc's ls aliases
brew "fd"
brew "fzf"
brew "git"
brew "git-delta"   # ~/.gitconfig's pager
brew "jq"
brew "ripgrep"
brew "zoxide"

# --- System / misc ---
brew "htop"
{{ if not $intel }}brew "mise"{{ end }}   # from its own release binary on Intel: run_install-mise-intel-mac.sh
brew "tmux"
{{- else -}}
# Brewfile (mac-personal) — apply with `brew bundle --global`
# Languages (node, python, terraform, opentofu) are managed by mise.
#
# A machine with the docker-engine role is a LAB NODE: an engine other machines
# build on, reached over ssh, with nobody sitting at it. It gets the same
# command-line experience as the desktops — prompt, completions, kubernetes
# tools, the lot — by DENY-LIST rather than allow-list, so anything added here
# later reaches it automatically. Three groups are withheld, for reasons that are
# properties of the machine rather than opinions about the tools:
#   * media and graphics (ffmpeg, imagemagick, ghostscript, librsvg) — nothing
#     renders on a headless box, and on Intel these are the expensive source
#     builds, 10 to 15 dependencies each.
#   * cloud CLIs (aws, azure, aliyun, oci) — a lab node is deliberately given no
#     credentials, so they would have nothing to authenticate with.
#   * every GUI cask except the engine itself.
# The Go-based tools still build from source on Intel, but at one dependency
# each that is minutes, not hours, and only once.

# --- Taps ---
