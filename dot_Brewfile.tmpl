{{- /* A machine's own packages (README, "Work overlay"): ~/.config/dotfiles/packages.toml
       may skip or replace entries below, and ~/.Brewfile.local is added at the end. The
       packages-filter template applies them to this file's own text, which it gets by
       rendering this file again with packages_raw set. With neither file the output is
       the list exactly as written. That second pass reads the file from the source
       directory, so rendering a copy over stdin (an older one from `git archive`, say)
       needs --source pointing at the copy's tree. */ -}}
{{- if not (hasKey . "packages_raw") -}}
{{-   includeTemplate "packages-filter" (dict "file" "dot_Brewfile.tmpl" "format" "brew" "data" .) | trimSuffix "\n" -}}
{{- else -}}
{{- if eq .machine "mac-personal" -}}
{{- $lab := false -}}{{- if hasKey . "roles" }}{{ $lab = has "docker-engine" .roles }}{{ end -}}
{{- /* A session host's CLI takes the stable channel, the owner's choice: kept on
       2026-11-01 when the concierge, the command-line Claude Code it was first
       chosen for, was dropped (decision 0022 in the vault). A lab node runs no
       sessions. */ -}}
{{- $host := false -}}{{- if hasKey . "roles" }}{{ $host = and (has "session-host" .roles) (not $lab) }}{{ end -}}
{{- /* An INTEL Mac. Homebrew stopped building Intel bottles in September 2026, so a
       formula with no bottle is compiled here, and a few of them drag in Rust and
       LLVM first: hours, repeated on every toolchain release. Those come from their
       own prebuilt binaries through mise instead; see decision 0006 in the vault.
       Since 2026-11-09 (decision 0026) that is every formula mise can supply.
       Keyed on the architecture, never on a machine name, like the casks below. */ -}}
{{- $intel := eq .chezmoi.arch "amd64" -}}
{{- /* A LAB NODE (role docker-engine) is a server, and on a server boring wins: its
       command-line tools come from mise on any chip, each the project's own release
       build, with no shared library tree to move under them (decision 0027 in the
       vault). So on an Intel Mac or a lab node each formula mise can supply starts
       with "# from mise here:", which comments it out, and the mise config's block
       for both installs it; elsewhere the line renders as before. yh has no
       Apple-silicon build, so only Intel takes it from mise. What Homebrew keeps on
       such a Mac is the casks and the formulae with no build for its chip, which
       stay at the versions that work: `up` upgrades only casks there, so nothing
       needs pinning. git-lfs, lnav, vhs and vsce are not on such a Mac at all: a
       headless engine host does not need every comfort. */ -}}
{{- $fromMise := or $intel $lab -}}
{{- /* An APPLIANCE gets its own short list and nothing below it. It wins over any
       role it is combined with, as the lab node wins over session-host. */ -}}
