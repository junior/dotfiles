{{- if eq .machine "mac-personal" -}}
{{- $lab := false -}}{{- if hasKey . "roles" }}{{ $lab = has "docker-engine" .roles }}{{ end -}}
{{- /* An INTEL Mac. Homebrew stopped building Intel bottles in September 2026, so a
       formula with no bottle is compiled here, and a few of them drag in Rust and
       LLVM first: hours, repeated on every toolchain release. Those come from their
       own prebuilt binaries through mise instead; see decision 0006 in the vault.
       Keyed on the architecture, never on a machine name, like the casks below. */ -}}
{{- $intel := eq .chezmoi.arch "amd64" -}}
# Brewfile (mac-personal) — apply with `brew bundle --global`
# Languages (node, python, terraform, opentofu) are managed by mise.
#
# A machine with the docker-engine role is a LAB NODE: an engine other machines
# build on, reached over ssh, with nobody sitting at it. It gets the same
# command-line experience as the desktops — prompt, completions, kubernetes
# tools, the lot — by DENY-LIST rather than allow-list, so anything added here
# later reaches it automatically. Three groups are withheld, for reasons that are
# properties of the machine rather than opinions about the tools:
#   * media and graphics (ffmpeg, imagemagick, ghostscript, librsvg) — nothing
#     renders on a headless box, and on Intel these are the expensive source
#     builds, 10 to 15 dependencies each.
#   * cloud CLIs (aws, azure, aliyun, oci) — a lab node is deliberately given no
#     credentials, so they would have nothing to authenticate with.
#   * every GUI cask except the engine itself.
# The Go-based tools still build from source on Intel, but at one dependency
# each that is minutes, not hours, and only once.

# --- Taps ---
tap "docker/tap"     # Docker Sandboxes (sbx)
tap "junior/tap"

# --- Formulae: shell + completions ---
brew "powerlevel10k"
brew "zsh"
brew "zsh-autosuggestions"
brew "zsh-completions"
brew "zsh-history-substring-search"
brew "zsh-syntax-highlighting"

# --- Formulae: cloud CLIs (not via mise) ---
{{ if not $lab }}brew "aliyun-cli"{{ end }}
{{ if not $lab }}brew "awscli"{{ end }}
{{ if not $lab }}brew "azure-cli"{{ end }}
{{ if not $lab }}brew "oci-cli"{{ end }}
{{ if not $intel }}brew "vercel-cli"{{ end }}   # not on Intel: it needs node, and node is a long build here

# --- Formulae: kubernetes / cloud-native ---
brew "calicoctl"
brew "cilium-cli"
brew "cosign"
brew "dive"
brew "falcoctl"
brew "grpcurl"
brew "grype"
brew "helm"
brew "ingress2gateway"
brew "istioctl"
brew "k3d"
brew "k9s"
brew "kind"
brew "krew"
brew "ktop"
brew "kubecolor"
brew "kubectx"
brew "kubeshark"
brew "minikube"
brew "operator-sdk"
brew "stern"
brew "syft"
brew "trivy"

# --- Formulae: dev utilities ---
brew "asciinema"
brew "bat"
brew "chezmoi"
brew "direnv"
brew "duf"
brew "eza"
brew "fd"
brew "fx"
brew "fzf"
brew "gh"
brew "git"
# delta is what ~/.gitconfig names as core.pager and the interactive diffFilter. It was
# only ever declared for wsl-work (mise), so on a Mac git was configured to page
# through a program that was not there. Unnoticed for months because a pager only
# runs when stdout is a terminal, and most git here runs from tools and GUIs.
brew "git-delta"
brew "git-filter-repo"
{{ if not $intel }}brew "git-lfs"{{ end }}   # not on Intel: its man pages need asciidoctor, so Ruby, so Rust
brew "httpie"
brew "jq"
{{ if not $intel }}brew "lnav"{{ end }}   # not on Intel: needs Rust to build and ships no Intel binary
brew "mkcert"
brew "pinentry-mac"   # GUI passphrase prompt for gpg-agent (see ~/.gnupg/gpg-agent.conf)
brew "ripgrep"
brew "junior/tap/skilla"
brew "terraform-docs"
brew "tfsec"
{{ if not $intel }}brew "vhs"{{ end }}   # not on Intel: pulls the whole ffmpeg stack in from source
{{ if not $intel }}brew "vsce"{{ end }}   # not on Intel: would rebuild node
brew "yh"
brew "yq"
brew "zoxide"

# --- Formulae: system / misc ---
brew "agg"
brew "autoconf"
{{ if not $lab }}brew "ffmpeg"{{ end }}
{{ if not $lab }}brew "ghostscript"{{ end }}
brew "gifsicle"
brew "htop"
{{ if not $lab }}brew "imagemagick"{{ end }}
{{ if not $lab }}brew "librsvg"{{ end }}
{{ if not $intel }}brew "mise"{{ end }}   # from its own release binary on Intel: run_install-mise-intel-mac.sh
brew "pipx"
brew "timewarrior"
brew "tmux"
{{ if not $intel }}brew "uv"{{ end }}   # from mise on Intel (Rust, and no Intel bottle)

{{ if $lab -}}
# --- Casks: lab node ---
# Nobody sits at this machine, so it gets no GUI. But "no GUI" is not "no
# casks": several of these ship a COMMAND-LINE tool and no .app at all, and a
# box you ssh into wants those as much as any other machine does. The rule is
# what the cask installs, not how it is packaged.
cask "docker-desktop"          # the engine, and the reason this machine exists
cask "claude-code@latest"      # CLI, no .app
cask "codex"                   # CLI, no .app (chatgpt is the GUI one and stays off)
cask "ngrok"                   # CLI, no .app
cask "mitmproxy"               # CLI, no .app
# Deliberately NOT here: 1password-cli. A lab node is given no credentials, so
# `op` would have nothing to unlock. If that changes, this is the line to add.
{{- else }}
# --- Casks: terminal + editors ---
cask "cursor"
cask "ghostty"
cask "visual-studio-code"

# --- Casks: browsers ---
cask "arc"
cask "firefox"
cask "google-chrome"
cask "google-chrome@canary"   # renamed upstream from google-chrome-canary (old name 404s)
cask "tor-browser"

# --- Casks: network ---
# wifiman installs via pkg (one sudo prompt the first time); wireshark-app is the
# GUI (the `wireshark` formula is the CLI-only build) and ships a ChmodBPF pkg.
cask "wifiman"
# Wireshark is deliberately NOT declared. The `wireshark-app` cask installs two pkgs
# besides the app: "Add Wireshark to the system path" and "Install ChmodBPF", the latter
# a ROOT LaunchDaemon that chmods /dev/bpf* at every boot so non-root processes can
# capture. That is a persistent, admin-level change to how the machine handles packet
# capture, and it is not something a new Mac should acquire silently. Wireshark is an
# on-demand tool here: install it by hand when a capture is actually needed
#   brew install --cask wireshark-app
# or better, capture inside a container on a lab node and leave the Mac untouched.

# --- Casks: containers + Kubernetes UIs ---
cask "docker-desktop"
cask "freelens"
cask "openlens"
cask "stratoshark"

# --- Casks: communication + productivity ---
# 1Password: the direct-download build (not the App Store one), adopted in place.
cask "1password"
# The CLI (`op`). Needed for the secrets plan: chezmoi `onepasswordRead` in templates so
# ~/.aws and the s3tx exports stop being hand-carried, and it is what makes a new Mac
# reproducible rather than hand-built. Two things stay manual in the app, they are GUI
# toggles: Settings > Developer > "Integrate with 1Password CLI", and the SSH agent.
# Not pinned: this cask has no auto_updates, `brew upgrade` in `up` moves it.
cask "1password-cli"
cask "discord"
cask "microsoft-teams"
cask "notion"
# Obsidian: the reader for ~/vault, a git-backed Markdown vault shared by several
# tools. Self-updating, so it is pinned in run_pin-self-updating-casks.sh. A GUI app,
# so a lab node never gets it; the vault itself is plain files and needs no app.
cask "obsidian"
cask "webex"
cask "zoom"

# --- Casks: dev tools / API ---
cask "apidog"
# ForkLift (licensed; the licence lives in ~/Library, the cask only owns the bundle)
# and Monokle were hand-installed before; managed from here on.
cask "forklift"
cask "monokle"
cask "dash"
cask "drawio"
cask "github"
cask "gitkraken"
cask "gpg-suite"
cask "httpie-desktop"
cask "jetbrains-toolbox"
cask "kaleidoscope"
cask "mitmproxy"
cask "ngrok"
cask "postman"
cask "termius"
cask "tower"

# --- Casks: AI / misc ---
cask "chatgpt"
# Claude Desktop. Self-updating, so it is pinned in run_onchange_pin-self-updating-casks.sh:
# brew must never try to replace a running, root-owned app bundle (the Chrome lesson).
cask "claude"
# Claude Code CLI. Two casks exist and they conflict, so pick one: `claude-code` follows
# the stable channel (about a week behind, skipping releases with known major regressions),
# `claude-code@latest` takes every release. @latest matches wsl-work, whose native install
# tracks the same channel. NOTE the difference in who updates it: a Homebrew install does
# not self-update, so `up`'s `brew upgrade` is what moves this one, while wsl-work's
# native install updates itself in the background.
cask "claude-code@latest"
cask "codex"
cask "grammarly-desktop"
cask "microsoft-auto-update"
{{- if eq .chezmoi.arch "arm64" }}
# Apple-silicon-only casks (their upstream ships no Intel build), gated on the
# architecture rather than the machine name so an Intel Mac can share this
# profile without `brew bundle` failing on them every `up`.
# sbx: microVM sandboxes for coding agents. Standalone — its own VM backend,
# independent of any Docker/Podman engine. Linux needs KVM; macOS does not.
cask "docker/tap/sbx"
cask "lm-studio"
{{- end }}

# --- Casks: fonts ---
cask "font-meslo-lg-nerd-font"
{{- end }}
{{- end }}
