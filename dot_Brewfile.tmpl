brew "k3d"
brew "k9s"
brew "kind"
brew "krew"
brew "ktop"
brew "kubecolor"
brew "kubectx"
brew "kubeshark"
brew "minikube"
brew "operator-sdk"
brew "stern"
brew "syft"
brew "trivy"

# --- Formulae: dev utilities ---
brew "asciinema"
brew "bat"
brew "chezmoi"
brew "direnv"
brew "duf"
brew "eza"
brew "fd"
brew "fx"
brew "fzf"
