{{- /* ~/.gitconfig — managed by chezmoi. Personal identity by default; a work
       machine overrides the email via ~/.gitconfig.local (see [include] at end). */ -}}
[user]
	name = Adao Oliveira Jr
	email = junior@users.noreply.github.com
{{- if hasKey . "signingkey" }}
	# Signing key fingerprint comes from the machine-local chezmoi data file
	# (~/.config/chezmoi/chezmoi.toml, never in this repo) — set `signingkey`
	# there on machines that sign. Omitted entirely where it is not set, so a
	# fork never inherits someone else's key.
	signingkey = {{ .signingkey }}
{{- end }}

[core]
	pager = delta
	editor = code --wait

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[pull]
	rebase = false

[fetch]
	prune = true

# Work machines drop a ~/.gitconfig.local (from the private overlay) that
# overrides the email above; git silently ignores a missing include.
{{- if hasKey . "signingkey" }}

# OpenPGP (not the newer SSH signing format) — matches the signingkey above.
[gpg]
	format = openpgp

# Sign every commit and annotated tag. Inside the same `signingkey` guard on
# purpose: a fork or a machine without the key must never get gpgsign=true, or
# EVERY commit fails. Repos that commit under a DIFFERENT identity (one with no
# GPG key) must turn this off — per repo, or via an includeIf in ~/.gitconfig.local.
[commit]
	gpgsign = true

[tag]
	gpgSign = true
{{- end }}

[include]
	path = ~/.gitconfig.local
{{- if lookPath "git-lfs" }}

# Managed here so `git lfs install` doesn't drift ~/.gitconfig out-of-band.
# Only emitted where git-lfs is actually installed (required=true errors otherwise).
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- end }}
