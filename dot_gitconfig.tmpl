{{- /* ~/.gitconfig — managed by chezmoi. Personal identity by default; a work
       machine overrides the email via ~/.gitconfig.local (see [include] at end). */ -}}
[user]
	name = Adao Oliveira Jr
	email = junior@users.noreply.github.com
{{- if ne .machine "wsl-work" }}
	# Personal OpenPGP key — a public FINGERPRINT, safe to publish. It only says
	# WHICH key to sign with, enabling `git commit -S` / `git tag -s` without
	# naming it. Personal machines only — the work box commits under a
	# different identity via ~/.gitconfig.local and never uses this key.
	signingkey = 39A6CFBD3BD1535104068B15DEF5828DA2AE0DF2
{{- end }}

[core]
	pager = delta
	editor = code --wait

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[pull]
	rebase = false

[fetch]
	prune = true

# Work machines drop a ~/.gitconfig.local (from the private overlay) that
# overrides the email above; git silently ignores a missing include.
{{- if ne .machine "wsl-work" }}

# OpenPGP (not the newer SSH signing format) — matches the signingkey above.
[gpg]
	format = openpgp
{{- end }}

[include]
	path = ~/.gitconfig.local
{{- if lookPath "git-lfs" }}

# Managed here so `git lfs install` doesn't drift ~/.gitconfig out-of-band.
# Only emitted where git-lfs is actually installed (required=true errors otherwise).
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- end }}
