{{ if eq .machine "wsl-work" -}}
#!/usr/bin/env bash
# Claude Code CLI — native installer (self-updating; no npm, per preference).
# tools-category: AI / agents
# tools-installs: claude-code
#
# The corp proxy gates claude.ai behind an "acknowledge the internal AI usage
# documentation" page. Until that is acknowledged (in the Windows browser), the
# install URL returns that HTML page instead of the script — so this NEVER pipes
# the download into bash: it fetches to a file, verifies it is actually a shell
# script, and only then runs it. On the HTML page it explains what to do instead.
#
# Bootstrap only: exits once `claude` exists; after that the native install
# keeps ITSELF updated (launcher ~/.local/bin/claude -> ~/.local/share/claude).
set -eu

if command -v claude >/dev/null 2>&1 || [ -x "$HOME/.local/bin/claude" ]; then
  exit 0
fi

echo ">>> claude-code: installing (native)"
tmp="$(mktemp)"
if ! curl -fsSL --max-time 60 -o "$tmp" https://claude.ai/install.sh; then
  echo ">>> WARN: cannot download the installer (network/proxy) — skipping"
  rm -f "$tmp"; exit 0
fi

# The one lesson this script exists to remember: validate before executing.
if ! head -c 200 "$tmp" | grep -qE '^#!/(usr/)?bin/(env )?(ba)?sh'; then
  echo ">>> WARN: claude.ai served something that is NOT the install script"
  head -c 120 "$tmp" | tr -d '\n' | sed 's/^/>>>   payload starts: /'; echo
  echo ">>>   Likely the corp 'AI usage documentation' acknowledgment gate."
  echo ">>>   Open https://claude.ai in the Windows browser, acknowledge it,"
  echo ">>>   then re-run:  chezmoi state delete-bucket --bucket=scriptState && chezmoi apply"
  rm -f "$tmp"; exit 0
fi

if bash "$tmp"; then
  if [ -x "$HOME/.local/bin/claude" ]; then
    echo ">>> claude-code $("$HOME/.local/bin/claude" --version 2>/dev/null | head -1) installed — run 'claude' to log in"
  else
    echo ">>> claude-code installed — open a new shell, then run 'claude' to log in"
  fi
else
  echo ">>> WARN: installer ran but failed — retry after checking network/proxy"
fi
rm -f "$tmp"
{{ end -}}
