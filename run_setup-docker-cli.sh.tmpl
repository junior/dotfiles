{{ if eq .machine "wsl-work" -}}
#!/usr/bin/env bash
# Real docker CLI against ROOTLESS PODMAN ("Option A" — one engine, no daemon):
# the genuine docker client (mise: docker-cli) talks to podman's Docker-compatible
# API socket, so `docker image ls` == `podman image ls`. DOCKER_HOST is exported
# in .zshrc.
#
# This is a plain run_ script: it executes on EVERY `chezmoi apply` (i.e. every
# `up`) so the docker CLI plugins TRACK UPSTREAM LATEST — a download happens only
# when the release tag differs from the recorded one (.<plugin>.version sidecar
# files); otherwise it's two cheap API calls. Network failures WARN and keep the
# current binaries — `up` never breaks offline.
# QUIET BY DESIGN: nothing is printed when everything is already current — only
# actual updates and warnings produce output (like the rest of the toolchain).
#
# Plugins managed here (no Docker Desktop on WSL to bundle them; on the mac both
# come with Desktop and update on its cadence):
#   docker-dhi   — DHI CLI  (github.com/docker-hardened-images/dhictl, raw binary)
#   docker-scout — Scout    (github.com/docker/scout-cli, tarball)
#   docker-buildx — Buildx  (github.com/docker/buildx, raw binary)
# NOTE on buildx + podman: buildx's DEFAULT "docker" driver needs the Docker
# Engine's built-in BuildKit, which podman does not provide. Use the
# docker-container driver instead — it runs buildkitd as a container, which
# podman can host:  docker buildx create --driver docker-container --use
# Finally it wires a `corp` buildx builder that trusts the corporate CA (see below).
# The old podman-docker apt emulator shim is superseded: sudo apt-get remove podman-docker
set -eu

if ! systemctl --user is-active --quiet podman.socket; then
  echo ">>> docker-on-podman: enabling rootless podman API socket"
  systemctl --user enable --now podman.socket
fi

PLUGIN_DIR="$HOME/.docker/cli-plugins"
mkdir -p "$PLUGIN_DIR"

# Authenticated API calls when GITHUB_TOKEN is set (corp NAT shares the anon limit).
fetch_latest_tag() {  # $1 = owner/repo -> prints tag or nothing on failure
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    curl -fsSL -H "Authorization: token $GITHUB_TOKEN" "https://api.github.com/repos/$1/releases/latest" 2>/dev/null
  else
    curl -fsSL "https://api.github.com/repos/$1/releases/latest" 2>/dev/null
  fi | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1
}

# ---- docker-dhi (raw binary asset) ----
latest="$(fetch_latest_tag docker-hardened-images/dhictl || true)"
cur="$(cat "$PLUGIN_DIR/.docker-dhi.version" 2>/dev/null || true)"
if [ -z "$latest" ]; then
  echo ">>> WARN: cannot resolve dhictl latest (offline/rate-limit?) — keeping ${cur:-none}"
elif [ "$latest" = "$cur" ] && [ -x "$PLUGIN_DIR/docker-dhi" ]; then
  :   # current — stay silent
else
  echo ">>> docker-dhi: ${cur:-none} -> $latest"
  tmp="$(mktemp)"
  if curl -fsSL -o "$tmp" \
       "https://github.com/docker-hardened-images/dhictl/releases/download/${latest}/dhictl-linux-amd64"; then
    install -m 0755 "$tmp" "$PLUGIN_DIR/docker-dhi"
    printf '%s\n' "$latest" > "$PLUGIN_DIR/.docker-dhi.version"
    echo ">>> docker-dhi $latest installed"
  else
    echo ">>> WARN: dhictl download failed — keeping ${cur:-none}"
  fi
  rm -f "$tmp"
fi

# ---- docker-scout (versioned tarball asset) ----
latest="$(fetch_latest_tag docker/scout-cli || true)"
cur="$(cat "$PLUGIN_DIR/.docker-scout.version" 2>/dev/null || true)"
if [ -z "$latest" ]; then
  echo ">>> WARN: cannot resolve scout latest (offline/rate-limit?) — keeping ${cur:-none}"
elif [ "$latest" = "$cur" ] && [ -x "$PLUGIN_DIR/docker-scout" ]; then
  :   # current — stay silent
else
  echo ">>> docker-scout: ${cur:-none} -> $latest"
  ver="${latest#v}"
  tmpd="$(mktemp -d)"
  if curl -fsSL -o "$tmpd/scout.tgz" \
       "https://github.com/docker/scout-cli/releases/download/${latest}/docker-scout_${ver}_linux_amd64.tar.gz" \
     && tar -xzf "$tmpd/scout.tgz" -C "$tmpd" docker-scout; then
    install -m 0755 "$tmpd/docker-scout" "$PLUGIN_DIR/docker-scout"
    printf '%s\n' "$latest" > "$PLUGIN_DIR/.docker-scout.version"
    echo ">>> docker-scout $latest installed"
  else
    echo ">>> WARN: scout download failed — keeping ${cur:-none}"
  fi
  rm -rf "$tmpd"
fi

# ---- docker-buildx (raw binary, version embedded in the asset name) ----
latest="$(fetch_latest_tag docker/buildx || true)"
cur="$(cat "$PLUGIN_DIR/.docker-buildx.version" 2>/dev/null || true)"
if [ -z "$latest" ]; then
  echo ">>> WARN: cannot resolve buildx latest (offline/rate-limit?) — keeping ${cur:-none}"
elif [ "$latest" = "$cur" ] && [ -x "$PLUGIN_DIR/docker-buildx" ]; then
  :   # current — stay silent
else
  echo ">>> docker-buildx: ${cur:-none} -> $latest"
  tmp="$(mktemp)"
  if curl -fsSL -o "$tmp" \
       "https://github.com/docker/buildx/releases/download/${latest}/buildx-${latest}.linux-amd64"; then
    install -m 0755 "$tmp" "$PLUGIN_DIR/docker-buildx"
    printf '%s\n' "$latest" > "$PLUGIN_DIR/.docker-buildx.version"
    echo ">>> docker-buildx $latest installed"
  else
    echo ">>> WARN: buildx download failed — keeping ${cur:-none}"
  fi
  rm -f "$tmp"
fi

# ---- buildx builder that trusts the corporate CA ----
# BuildKit runs in its OWN container with its OWN trust store, so the corp
# TLS-inspection CA that this host trusts is invisible to it and every image pull
# dies with "x509: certificate signed by unknown authority".
#
# buildx COPIES any file referenced by `ca=` in buildkitd.toml into the builder
# container and rewrites the path to /etc/buildkit/certs/<registry>/<file>.
# `ca=` alone is per-registry, but pointing Go's SSL_CERT_FILE at that same copy
# makes the trust apply to EVERY registry the build touches. SSL_CERT_FILE
# REPLACES the root set rather than adding to it, so the bundle must carry the
# public roots too — hence system bundle + corp bundle concatenated.
#
# default-load=true restores classic behaviour: the docker-container driver keeps
# results in the build cache only, so `docker build` would leave nothing in
# `docker image ls` and nag for --load/--push. It costs an export per build and
# cannot apply to multi-platform builds (use --push for those).
BK_DIR="$HOME/.config/buildkit"
BK_BUNDLE="$BK_DIR/corp-ca-bundle.crt"
BK_TOML="$BK_DIR/buildkitd.toml"
BK_BUILDER="corp"
SYS_CA="/etc/ssl/certs/ca-certificates.crt"
CORP_CA_CACHE="$BK_DIR/corp-roots.crt"
# Optional extra root bundle, supplied per machine via the untracked chezmoi data
# file (~/.config/chezmoi/chezmoi.toml: corp_ca_url = "https://..."). Kept out of
# this repo so no employer URL ships in it. Unset = system roots only, which is
# already sufficient wherever the inspection CA is installed system-wide.
CORP_CA_URL="{{ if hasKey . "corp_ca_url" }}{{ .corp_ca_url }}{{ end }}"

if command -v docker >/dev/null 2>&1 && [ -x "$PLUGIN_DIR/docker-buildx" ] && [ -r "$SYS_CA" ]; then
  mkdir -p "$BK_DIR"

  # Refresh the extra root bundle at most monthly (the system store already carries
  # the inspection CA; this is belt-and-braces and must never block `up`).
  if [ -n "$CORP_CA_URL" ] && { [ ! -s "$CORP_CA_CACHE" ] || [ -n "$(find "$CORP_CA_CACHE" -mtime +30 2>/dev/null)" ]; }; then
    if ! curl -fsSL --max-time 20 -o "$CORP_CA_CACHE.tmp" "$CORP_CA_URL" 2>/dev/null; then
      rm -f "$CORP_CA_CACHE.tmp"
      [ -s "$CORP_CA_CACHE" ] || echo ">>> WARN: corp CA bundle unreachable — using system roots only"
    else
      mv "$CORP_CA_CACHE.tmp" "$CORP_CA_CACHE"
    fi
  fi

  tmp_bundle="$(mktemp)"
  cat "$SYS_CA" > "$tmp_bundle"
  if [ -s "$CORP_CA_CACHE" ]; then cat "$CORP_CA_CACHE" >> "$tmp_bundle"; fi

  # Recreate the builder only when the trust material or the builder itself changed.
  # Bump BK_REV whenever the builder's driver options below change — it is part of
  # the recorded fingerprint, so the builder is recreated instead of silently stale.
  BK_REV="r2"
  new_sum="$(sha256sum "$tmp_bundle" | cut -d" " -f1)-$BK_REV"
  old_sum="$(cat "$BK_DIR/.bundle.sha256" 2>/dev/null || true)"
  if [ "$new_sum" != "$old_sum" ] || ! docker buildx inspect "$BK_BUILDER" >/dev/null 2>&1; then
    mv "$tmp_bundle" "$BK_BUNDLE"
    printf '[registry."docker.io"]\n  ca=["%s"]\n' "$BK_BUNDLE" > "$BK_TOML"
    echo ">>> buildx: (re)creating the '$BK_BUILDER' builder with the corporate CA"
    docker buildx rm "$BK_BUILDER" >/dev/null 2>&1 || true
    if docker buildx create --name "$BK_BUILDER" --driver docker-container --use \
         --config "$BK_TOML" \
         --driver-opt "env.SSL_CERT_FILE=/etc/buildkit/certs/docker.io/$(basename "$BK_BUNDLE")" \
         --driver-opt default-load=true \
         >/dev/null 2>&1; then
      printf '%s\n' "$new_sum" > "$BK_DIR/.bundle.sha256"
      echo ">>> buildx: '$BK_BUILDER' ready (docker buildx build now trusts the corp CA)"
    else
      echo ">>> WARN: could not create the '$BK_BUILDER' buildx builder"
    fi
  else
    rm -f "$tmp_bundle"   # current — stay silent
  fi
fi
{{ end -}}
