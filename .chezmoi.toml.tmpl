{{- /* Prompted once per machine on `chezmoi init`; stored in ~/.config/chezmoi/chezmoi.toml.
       Every value uses a *Once helper: an answer already present in the config is reused, so
       re-running `chezmoi init` (e.g. after this template changes) never loses local settings.
       Optional values may be left blank — the templates that consume them then emit nothing. */ -}}
{{- $machine := promptChoiceOnce . "machine" "Which machine is this" (list "mac-personal" "wsl-work" "linux-minimal") -}}
{{- $signingkey := promptStringOnce . "signingkey" "OpenPGP signing key fingerprint, blank for none" "" -}}
{{- $corpCaURL := promptStringOnce . "corp_ca_url" "Extra CA bundle URL for TLS-inspecting networks, blank for none" "" -}}
{{- /* Roles say what this machine DOES, as opposed to `machine`, which says what kind of
       setup it has. Four Macs can share the mac-personal profile and still differ on whether
       they host long-lived sessions or run an engine other machines build on. Roles are used
       rather than machine names because a role MOVES: when the desktop is down, session
       hosting shifts to the laptop by editing one line here, not by touching templates. */ -}}
{{- /* The ANSWER is stored as a string under roles_input; the parsed list is emitted
       separately as `roles`. They must be DIFFERENT keys: promptStringOnce reads its own
       key back to decide whether to ask again, and it cannot read a TOML array as a
       string, so sharing one key made a stored answer invisible to the prompt and it was
       dropped on the next init. */ -}}
{{- $roles := "" -}}
{{- if and (not (hasKey . "roles_input")) (hasKey . "roles") -}}
{{- /* Migration: an earlier version stored only the array. Seed the new key from
       it so a machine that already answered is never asked a second time. */ -}}
{{-   $roles = join "," .roles -}}
{{- else if eq $machine "mac-personal" -}}
{{-   $roles = promptStringOnce . "roles_input" "Roles for this machine, comma-separated: session-host, docker-engine, secrets. Blank for none, which is the common case. See the Machine roles table in README.md for which to pick" "" -}}
{{- end -}}
{{- /* Lab machines this one reaches over ssh, as alias=hostname pairs. Kept as a prompt
       because this repo is PUBLIC and home addresses do not belong in it, and because the
       names change: the structure lives here, the addresses live in your own config. */ -}}
{{- $labHosts := "" -}}
{{- if eq $machine "mac-personal" -}}
{{-   $labHosts = promptStringOnce . "lab_hosts" "Lab machines reachable over ssh, comma-separated alias:hostname pairs, for example imac:some-host.localdomain. Blank for none" "" -}}
{{- end -}}
{{- range (splitList "," $labHosts) -}}
{{-   $e := trim . -}}
{{-   if $e -}}
{{-     if ne (len (splitList ":" $e)) 2 -}}
{{-       fail (printf "malformed lab_hosts entry %s. Expected comma-separated alias:hostname pairs, for example imac:some-host.localdomain. A malformed entry would otherwise be skipped silently and the host would simply not resolve." $e) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $knownRoles := list "session-host" "docker-engine" "secrets" -}}
{{- $roleList := list -}}
{{- range (splitList "," $roles) -}}
{{-   $r := trim . -}}
{{-   if $r -}}
{{-     if not (has $r $knownRoles) -}}
{{-       fail (printf "unknown role %s. Known roles: %s. A typo here silently does nothing, which is why this stops instead. Fix the roles line in ~/.config/chezmoi/chezmoi.toml, or re-run 'chezmoi init' and answer again." $r (join ", " $knownRoles)) -}}
{{-     end -}}
{{-     $roleList = append $roleList $r -}}
{{-   end -}}
{{- end -}}
{{- $bigdisk := "" -}}
{{- $extras := "" -}}
{{- if eq $machine "linux-minimal" -}}
{{-   $bigdisk = promptStringOnce . "bigdisk" "Writable dir on a bigger filesystem for tools/caches, blank to keep everything in $HOME" "" -}}
{{-   $extras = promptStringOnce . "extras" "Optional extras, comma-separated. Available: krew (kubectl plugins, needs git), blesh (fish-style autosuggestions for bash). Blank for none" "" -}}
{{- end -}}

{{ if eq $machine "linux-minimal" -}}
# chezmoi writes run_ scripts into a temp directory and executes them there.
# Hardened hosts mount /tmp with noexec, which makes every script fail with
# "permission denied", so keep them under $HOME instead. Deliberately NOT inside
# ~/.local or ~/.cache: those two are the ones the bigdisk script relocates, and
# a script must not have its own file moved out from under it while it runs.
scriptTempDir = {{ (printf "%s/.chezmoi-tmp" .chezmoi.homeDir) | quote }}
{{ if $bigdisk }}
# The scripts themselves are tiny, but what they download is not: a mise tarball
# is 42 MB, the gadget kubectl plugin more, and krew keeps its whole store under
# KREW_ROOT. On a host whose home has tens of MB free, all of that must land on
# the big filesystem. This is the environment every run_ script inherits.
[scriptEnv]
    TMPDIR = {{ (printf "%s/tmp" $bigdisk) | quote }}
    MISE_TMP_DIR = {{ (printf "%s/tmp" $bigdisk) | quote }}
    KREW_ROOT = {{ (printf "%s/krew" $bigdisk) | quote }}
{{ end }}
{{ end -}}
[data]
    machine = {{ $machine | quote }}
    # Blank unless this machine signs commits: enables user.signingkey, gpg.format
    # and commit/tag signing in ~/.gitconfig.
    signingkey = {{ $signingkey | quote }}
    # Blank unless this machine is behind TLS inspection: extra roots appended to
    # the system bundle for the buildx builder.
    corp_ca_url = {{ $corpCaURL | quote }}
    # linux-minimal only. Some hosts give you a tiny home and a large shared
    # filesystem; point this at a directory you own there and caches, tool
    # installs, state and shell history go to it instead of filling $HOME.
    # Blank keeps the normal layout, which is what a Pi or a NUC wants.
    bigdisk = {{ $bigdisk | quote }}
    # Lab machines reachable over ssh, "alias:hostname" pairs, comma-separated.
    # Consumed by ~/.ssh/config.d/lab. Blank means that fragment is not applied.
    lab_hosts = {{ $labHosts | quote }}
    # What this machine DOES. A TOML array, so templates ask `has "session-host" .roles`.
    # Set only on mac-personal today; other profiles carry an empty list.
    #   session-host  hosts long-lived Claude Code sessions (launchd job, `up` bounces it)
    #   docker-engine runs a Docker engine other machines reach over ssh
    #   secrets       holds credentials provisioned from 1Password
    # roles_input is what you typed; `roles` is the parsed list that templates read.
    # Two keys on purpose: see the comment at the top of this template.
    roles_input = {{ $roles | quote }}
    roles = [{{ range $i, $r := $roleList }}{{ if $i }}, {{ end }}{{ $r | quote }}{{ end }}]
    # linux-minimal only. Optional groups this host should also get, comma-separated.
    # krew: kubectl plugin manager and the plugin list (needs git).
    # blesh: ble.sh, fish-style autosuggestions and highlighting in bash.
    extras = {{ $extras | quote }}
