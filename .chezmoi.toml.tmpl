{{- /* Prompted once per machine on `chezmoi init`; stored in ~/.config/chezmoi/chezmoi.toml.
       Only the machine identity is needed — git name/email are set in dot_gitconfig.tmpl
       (personal default) with the work email layered in via the private overlay. */ -}}
{{- $machine := promptChoiceOnce . "machine" "Which machine is this" (list "mac-personal" "wsl-work") -}}

[data]
    machine = {{ $machine | quote }}
    # Optional, machine-local, never tracked: uncomment on machines that sign
    # commits and git gets `user.signingkey` + `gpg.format = openpgp` rendered.
    # signingkey = "<your OpenPGP key fingerprint>"
    # Optional, machine-local: extra CA root bundle URL appended to the system
    # roots for the buildx builder on networks that inspect TLS.
    # corp_ca_url = "https://<your-pki-host>/roots.crt"
