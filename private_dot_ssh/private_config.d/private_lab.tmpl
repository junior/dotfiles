{{- $lab := "" -}}{{- if hasKey . "lab_hosts" }}{{ $lab = .lab_hosts }}{{ end -}}
{{- if $lab -}}
# ~/.ssh/config.d/lab — managed by chezmoi. Do not edit here.
#
# Generated from the `lab_hosts` value in ~/.config/chezmoi/chezmoi.toml, as
# "alias=hostname" pairs. The addresses are deliberately NOT in the dotfiles
# repo, which is public. To add, rename or move a machine, change that value
# and re-apply; nothing in the repo needs touching.
#
# Reached from ~/.ssh/config via `Include ~/.ssh/config.d/*`, which
# run_after_ensure-ssh-include.sh adds if it is missing. Include must be the
# FIRST line there, because ssh keeps the first value it sees for each keyword.
{{ range $i, $entry := splitList "," $lab -}}
{{- $pair := splitList "=" (trim $entry) -}}
{{- if eq (len $pair) 2 }}
Host {{ trim (index $pair 0) }}
    HostName     {{ trim (index $pair 1) }}
    User         {{ $.chezmoi.username }}
    # Interim key, generated 2026-09-20 with no passphrase so that unattended
    # callers (docker context over ssh) work. Replaced by the 1Password SSH
    # agent, at which point this becomes an IdentityAgent line instead.
    IdentityFile ~/.ssh/lab_temp_ed25519
    IdentitiesOnly yes
    # A lab node is driven by scripts and by `docker context`: keep the link
    # alive, and fail fast rather than hanging a build on an asleep machine.
    ServerAliveInterval 20
    ServerAliveCountMax 3
    ConnectTimeout 8
    # One TCP connection reused for repeated calls. docker context and rsync
    # make many in a row and the handshake is the slow part.
    ControlMaster auto
    ControlPath   ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
{{ end -}}
{{- end -}}
{{- end -}}
