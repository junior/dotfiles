{{- /* ~/.zshrc — managed by chezmoi. machine = "mac-personal" | "wsl-work" */ -}}
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# === PATH base ===
# ~/bin only while it still exists: it is being retired in favour of ~/.local/bin,
# and a PATH entry for a directory that is gone is just noise for `path` and lookups.
[[ -d "$HOME/bin" ]] && PATH="$HOME/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

{{ if eq .machine "wsl-work" -}}
ZSH_PLUGIN_DIR="$HOME/.zsh/plugins"
{{- else -}}
# === Homebrew (mac-personal) ===
for brewbin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [[ -x $brewbin ]] && eval "$($brewbin shellenv)" && break
done
ZSH_PLUGIN_DIR="${HOMEBREW_PREFIX:-/opt/homebrew}/share"
{{- end }}

# === mise (runtime & tool version manager) ===
command -v mise &>/dev/null && eval "$(mise activate zsh)"

# === Completions & plugins ===
fpath=("$HOME/.zsh/completions" $fpath)
{{- if ne .machine "wsl-work" }}
fpath+=("${HOMEBREW_PREFIX}/share/zsh/site-functions" "${HOMEBREW_PREFIX}/share/zsh-completions")
{{- end }}
# Ubuntu's /etc/zsh/zshrc runs compinit before this file, against a dump
# built before the fpath lines above. Use a private dump so our compinit
# does a real scan and registers ~/.zsh/completions (kubectl, helm, k9s).
ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
[[ -d ${ZSH_COMPDUMP:h} ]] || mkdir -p ${ZSH_COMPDUMP:h}
{{- if ne .machine "wsl-work" }}
# Homebrew makes its share/ directory group-writable BY DESIGN (drwxrwxr-x, group
# admin): Intel's in /usr/local, and Apple silicon's in /opt/homebrew can be too.
# A fresh install on the Mac Studio was, on 2026-11-01; the MacBook's older one was
# not, which is why only an Intel Mac had shown this before. compaudit calls that
# insecure, and compinit then halts every interactive shell - every ssh login, on a
# box nobody sits at - to ask whether to continue. -u accepts those directories.
# Scoped to Homebrew's two prefixes so no other machine loses the check; chmod
# would also work but comes back whenever brew recreates a directory, and a prompt
# that reappears months later on a headless machine is the worse failure.
if [[ "${HOMEBREW_PREFIX:-}" == /usr/local || "${HOMEBREW_PREFIX:-}" == /opt/homebrew ]]; then
  autoload -Uz compinit && compinit -u -d "$ZSH_COMPDUMP"
else
  autoload -Uz compinit && compinit -d "$ZSH_COMPDUMP"
fi
{{- else }}
autoload -Uz compinit && compinit -d "$ZSH_COMPDUMP"
{{- end }}
autoload -Uz bashcompinit && bashcompinit

if [[ -f "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
[[ -f "$ZSH_PLUGIN_DIR/powerlevel10k/powerlevel10k.zsh-theme" ]] && \
  source "$ZSH_PLUGIN_DIR/powerlevel10k/powerlevel10k.zsh-theme"

# === History ===
HISTFILE=~/.histfile
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY        # timestamp each entry
setopt SHARE_HISTORY           # share history across live sessions
setopt HIST_EXPIRE_DUPS_FIRST  # trim duplicates first when full
setopt HIST_IGNORE_ALL_DUPS    # drop older duplicate commands
setopt HIST_IGNORE_SPACE       # don't record commands starting with a space
# tx transfer codes are single-use, so persisted entries are pure noise. Filter tx
# calls from the history FILE only: alone, piped into, after && or ;, or with a
# variable in front. They never hit disk or other terminals, but stay
# up-arrow-able in the current session for retries.
HISTORY_IGNORE='(tx *|* tx *|*[;&|]tx *)'
setopt HIST_FIND_NO_DUPS       # skip dupes when searching
setopt HIST_REDUCE_BLANKS      # tidy whitespace
setopt HIST_VERIFY             # confirm history expansions before running

# === Shell options ===
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt EXTENDED_GLOB
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP
bindkey -e

# === Completion styling ===
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}%d%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zcompcache"

# === Environment ===
# Full locale set: perl (run by fzf's ctrl-r widget on WSL) warns if
# LC_ALL/LANGUAGE are unset even when LANG is set.
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LANGUAGE=en_US.UTF-8
export EDITOR='code --wait'
export VISUAL="$EDITOR"
export GPG_TTY=$(tty)
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export MANROFFOPT="-c"
# export BAT_THEME="Catppuccin Mocha"   # uncomment to match your terminal theme
export PATH="${PATH}:${HOME}/.krew/bin"
{{ if eq .machine "wsl-work" }}
# Corporate MITM CA bundle (wsl-work network intercepts HTTPS)
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
export NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
export REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# URLs open in the Windows browser (corp SSO lives there); xdg-open is the
# WSL shim installed by run_onchange_install-wsl-integration.sh.
[[ -x /usr/local/bin/xdg-open ]] && export BROWSER=xdg-open

# Container runtime (Podman)
export KIND_EXPERIMENTAL_PROVIDER=podman
if [[ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/podman/podman.sock" ]]; then
  export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$UID}/podman/podman.sock"
fi
# `docker build` does NOT honour `docker buildx use` — it falls back to the
# daemon's default builder, which carries no corporate CA (every internal
# registry then fails "x509: certificate signed by unknown authority").
# BUILDX_BUILDER is honoured by BOTH `docker build` and `docker buildx build`,
# so point them at the CA-carrying builder that run_setup-docker-cli.sh creates.
# Guarded on the instance file so a not-yet-provisioned machine still builds.
[[ -f "$HOME/.docker/buildx/instances/corp" ]] && export BUILDX_BUILDER=corp

# Persistent ssh-agent: WSL has no launchd/systemd user agent, so bind one
# agent to a fixed socket and let every shell reuse it. Keys land in it via
# AddKeysToAgent in ~/.ssh/config — passphrase asked once per boot, on first use.
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
ssh-add -l &>/dev/null
if [[ $? -eq 2 ]]; then  # 2 = no agent on the socket (0 = keys, 1 = empty agent)
  rm -f "$SSH_AUTH_SOCK"
  (umask 077; ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null)
fi
{{ end -}}

# === Tool initialization ===
if command -v fzf &>/dev/null; then
  eval "$(fzf --zsh)"
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --info=inline"
  if command -v fd &>/dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  fi
  export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:500 {}'"
  export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always --level=2 {} | head -200'"
  alias vc='fzf | xargs code'
fi

command -v zoxide &>/dev/null && eval "$(zoxide init zsh --cmd cd)"
# direnv writes the absolute path of the binary that made the hook into the hook.
# Where mise installs direnv (wsl-work) that path names the version, and `up`
# upgrades and then prunes it, so every shell opened before an upgrade called a
# deleted file at each prompt ("no such file or directory: .../direnv/2.37.1/direnv",
# 2026-10-07). The hook calls it by name instead, through PATH, which mise's own
# prompt hook keeps on the current version; until that hook has run once in an old
# shell, the stale entry is skipped quietly. Both hook formats are covered:
# $'/path/direnv' (2.38) and "/path/direnv" (earlier).
if command -v direnv &>/dev/null; then
  _direnv_run() {
    [[ -x ${commands[direnv]-} ]] || rehash
    [[ -x ${commands[direnv]-} ]] && command direnv "$@"
  }
  () {
    setopt localoptions extendedglob
    local hook; hook=$(direnv hook zsh)
    eval "${hook//(\$\'|\")\/[^\'\"]##\/direnv(\'|\") export/_direnv_run export}"
  }
fi

if command -v kubecolor &>/dev/null; then
  export KUBECOLOR_OBJ_FRESH="1h"
  (( $+_comps[kubectl] )) && compdef kubecolor=kubectl
fi

# === Completions for external tools ===
command -v ngrok &>/dev/null && eval "$(ngrok completion)"
command -v terraform &>/dev/null && complete -o nospace -C "$(command -v terraform)" terraform
# vault's Homebrew formula ships a native _vault; mise's install (wsl-work) ships none,
# so there it completes itself the terraform way.
command -v vault &>/dev/null && (( ! $+_comps[vault] )) && complete -o nospace -C "$(command -v vault)" vault
{{- if ne .machine "wsl-work" }}
command -v aws_completer &>/dev/null && complete -C "$(command -v aws_completer)" aws
{{- end }}
# kcx: KUBECONFIG from its layout (the state file, then one file per cluster), kept
# current before each prompt, and completion from its own word list. On the Macs
# ~/.zshenv already set KUBECONFIG for this shell; the snippet defines the same
# function and only adds the hook and the completion. A value someone set on purpose,
# a read-only shell's and a run's are left alone.
command -v kcx &>/dev/null && eval "$(kcx init zsh)"

# === Aliases ===
# --- Modern CLI replacements ---
alias cat='bat --style=plain --paging=never'   # no line numbers, no header
alias catp='bat'                               # full bat: header + numbers + pager
alias ls='eza --icons --group-directories-first'
alias ll='eza -lah --icons --git --group-directories-first'
alias la='eza -a --icons --group-directories-first'
alias lt='eza --tree --level=2 --icons --group-directories-first'
alias ltree='eza -lah --tree --level=3 --icons --group-directories-first'
alias grep='grep --color=auto'

# --- Navigation ---
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias reload='exec zsh'
alias zshrc='${EDITOR} ~/.zshrc'
alias path='print -l -- $path'

# --- Cloud Native ---
alias k=kubecolor
alias h=helm
# kcx keeps a kubeconfig file per cluster and switches contexts and namespaces
# (`kcx -h`); kubectx and kubens are retired.
alias kc=kcx
alias kcc='kcx -c'
alias kn='kcx ns'
alias knc='kcx ns -c'

# --- Terraform ---
alias tf=terraform

# --- Git ---
alias gs='git status -sb'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate --all'
alias gco='git checkout'
alias gp='git push'
alias gpl='git pull'
alias lg='lazygit'

{{ if eq .machine "wsl-work" -}}
# --- wsl-work specific (Mac muscle memory + tooling) ---
# NOTE: work-tooling alias overrides (e.g. kc/kcc) live in the private overlay's
# local.d fragments, sourced later — they win over the shared aliases above.
alias open='explorer.exe'                                  # open . / open file
alias pbcopy='clip.exe'                                    # pipe into clipboard
alias pbpaste='powershell.exe -NoProfile -Command Get-Clipboard | tr -d "\r"'
alias localip='hostname -I | awk "{print \$1}"'

# Rootful kind: in-cluster eBPF agents (Falco, Inspektor Gadget, Calico
# dataplane) must load BPF programs in the initial user namespace — rootless
# podman can't grant that. Rootless stays the default for everything else;
# only kind (and the podman it shells out to) runs as root here, and the
# kubeconfig is handed back to $USER afterwards.
rkind() {
  local kind_bin rc
  kind_bin="$(mise which kind 2>/dev/null)" || { echo "rkind: kind not installed via mise" >&2; return 1; }
  mkdir -p "$HOME/.kube"
  sudo KIND_EXPERIMENTAL_PROVIDER=podman KUBECONFIG="$HOME/.kube/config" "$kind_bin" "$@"
  rc=$?
  if [[ -e "$HOME/.kube/config" ]]; then
    sudo chown "$USER:" "$HOME/.kube/config" && chmod 600 "$HOME/.kube/config"
  fi
  if (( rc == 0 )) && [[ "${1:-}" == "create" ]]; then
    local name=kind
    local -i i
    for (( i = 1; i <= $#; i++ )); do
      case "${argv[i]}" in
        --name)   name="${argv[i+1]:-kind}" ;;
        --name=*) name="${argv[i]#--name=}" ;;
      esac
    done
    rkind-fix-kubeconfig "$name"
  fi
  return $rc
}

# WSL mirrored networking breaks loopback DNAT to rootful containers, so the
# 127.0.0.1:<port> endpoint kind writes into the kubeconfig times out. Point
# kubectl at the control-plane container IP instead — kubeadm includes that
# IP (the advertise address) in the API server cert SANs, so TLS validates.
# rkind runs this automatically after create; re-run by hand if a WSL restart
# hands the container a new IP. Usage: rkind-fix-kubeconfig [CLUSTER]
rkind-fix-kubeconfig() {
  local name="${1:-kind}" ip
  ip="$(sudo podman inspect "${name}-control-plane" 2>/dev/null | jq -r '.[0].NetworkSettings.Networks.kind.IPAddress // empty')"
  [[ -n "$ip" ]] || { echo "rkind-fix-kubeconfig: no IP found for ${name}-control-plane" >&2; return 1; }
  kubectl config set-cluster "kind-${name}" --server="https://${ip}:6443"
}

# Rootless and rootful podman have separate image storage: copy a locally
# built image across, then load it into a rootful kind cluster.
# Usage: rkind-load-image IMAGE [--name CLUSTER]
rkind-load-image() {
  (( $# >= 1 )) || { echo "usage: rkind-load-image IMAGE [kind load args...]" >&2; return 1; }
  local img=$1; shift
  podman save "$img" | sudo podman load || return
  rkind load docker-image "$img" "$@"
}
{{- else -}}
# --- mac-personal specific ---
alias localip='ipconfig getifaddr en0'
{{- end }}

# --- Update everything: dotfiles -> packages -> tools (same command on both machines) ---
# Show the prompted values this machine actually has. chezmoi warns when
# .chezmoi.toml.tmpl has changed upstream and the local config was generated
# from an older copy; answering `chezmoi init` from memory is how a machine ends
# up with a wrong value. It cannot lose an existing one -- every prompt uses a
# *Once helper, so an answer already present is REUSED WITHOUT ASKING and only
# genuinely new fields are asked -- but seeing the current set is what makes a
# new answer consistent with the rest.
chezconf() {
  local _d
  _d=$(chezmoi data --format=json 2>/dev/null) || { echo "chezconf: chezmoi data failed" >&2; return 1 }
  if command -v jq &>/dev/null; then
    print -r -- "$_d" | jq -r '
      def s(x): if ((x // "") | tostring) == "" then "(none)" else (x | tostring) end;
      "machine     = \(s(.machine))",
      "roles       = \(if ((.roles // []) | length) == 0 then "(none)" else ((.roles) | join(", ")) end)",
      "lab_hosts   = \(s(.lab_hosts))",
      "signingkey  = \(s(.signingkey))",
      "corp_ca_url = \(s(.corp_ca_url))",
      "bigdisk     = \(s(.bigdisk))",
      "extras      = \(s(.extras))"'
  else
    print -r -- "$_d"          # no jq: raw is still better than nothing
  fi
  echo
  echo "To CHANGE one of these, edit ~/.config/chezmoi/chezmoi.toml directly."
  echo "A *Once prompt will not ask again for a field that already has a value."
}

up() {
  # The private overlay FIRST, where there is one (work machines): pull it and re-link
  # its fragments, so the apply below already reads its package changes
  # (~/.config/dotfiles/packages.toml, ~/.Brewfile.local) and mise its conf.d.
  if [[ -d ~/.local/share/dotfiles-overlay/.git ]]; then
    # The overlay lives on a corp-internal host. When it can't be reached (VPN
    # down, or the corp VPN's posture/compliance check blocking corp resources until
    # a pending OS update is installed), the pull would otherwise hang ~2min on a TCP
    # timeout. So: skip unless the host RESOLVES, and cap the connect at 5s. Host
    # is derived from the remote to keep this file employer-neutral.
    local _ovhost _ovaddr=
    _ovhost=$(git -C ~/.local/share/dotfiles-overlay remote get-url origin 2>/dev/null \
      | sed -E 's#^[a-z]+://##; s#^[^@]*@##; s#[:/].*##')
    # getent answers on Linux. macOS has none, and the getent that zsh's compinit
    # defines there reads only /etc/hosts, so ask the system resolver, which also
    # follows a VPN's split DNS. dscacheutil exits 0 either way: its output answers.
    if [[ -n "$_ovhost" ]]; then
      if (( $+commands[getent] )); then
        _ovaddr=$(command getent hosts "$_ovhost" 2>/dev/null)
      else
        _ovaddr=$(dscacheutil -q host -a name "$_ovhost" 2>/dev/null | grep address)
      fi
    fi
    if [[ -n "$_ovaddr" ]]; then
      GIT_SSH_COMMAND='ssh -o ConnectTimeout=5 -o BatchMode=yes' \
        git -C ~/.local/share/dotfiles-overlay pull --rebase --autostash && \
        ~/.local/share/dotfiles-overlay/install.sh
    else
      echo "up: overlay host '${_ovhost:-?}' unreachable, skipping overlay sync (VPN down or corp access blocked?)"
    fi
  fi
  # Keep chezmoi's stderr visible, but also look at it: the "config file
  # template has changed" warning is the moment you need to see your current
  # answers, not three commands later.
  # `command cat`, here and below: the cat alias (bat) is expanded into this function
  # when it is defined, and on a new Mac the first `up` runs before Homebrew has
  # installed bat.
  local _cmerr; _cmerr=$(mktemp)
  chezmoi update 2>"$_cmerr" || { command cat "$_cmerr" >&2; rm -f "$_cmerr"; return 1 }
  command cat "$_cmerr" >&2
  if grep -q 'config file template has changed' "$_cmerr" 2>/dev/null; then
    echo
    echo "up: the chezmoi config template changed upstream, so this machine's config"
    echo "    was generated from an older copy. Existing answers are SAFE: chezmoi"
    echo "    reuses every value already set and asks only about new fields."
    echo "    What this machine has right now:"
    echo
    chezconf | sed 's/^/      /'
    echo "    Then run:  chezmoi init          (or 'chezmoi init --apply')"
    echo
  fi
  rm -f "$_cmerr"
  if command -v brew &>/dev/null; then
    # A package this machine skips or replaces (a "# skipped by" or "# replaced by"
    # line in ~/.Brewfile) can still be installed from before: brew bundle never
    # removes anything, and a leftover can block its replacement (two casks that link
    # the same command clash). Say so, with the command; removing it is yours.
    local _kind _name _rm
    sed -nE 's/^# (skipped|replaced) by [^:]*: (brew|cask) "([^"]+)".*/\2 \3/p' ~/.Brewfile 2>/dev/null \
      | while read -r _kind _name; do
          [[ $_kind == brew ]] && _kind=formula
          _name=${_name##*/}
          brew list --$_kind "$_name" &>/dev/null || continue
          _rm="brew uninstall --$_kind $_name"
          brew list --$_kind --pinned 2>/dev/null | grep -qx "$_name" && _rm="brew unpin --$_kind $_name && $_rm"
          echo "up: $_name is installed, but this machine skips or replaces it (~/.config/dotfiles/packages.toml). Remove it with: $_rm"
        done
    # `brew bundle` prints one "Using <x>" line per already-satisfied entry —
    # over a hundred lines that say nothing happened. Keep everything it did do,
    # drop the roll-call, and let the category summary below carry the shape of
    # the toolchain instead. A failure prints the whole log untouched.
    local _bundle=$(mktemp)
{{- if and (eq .chezmoi.os "darwin") (or (eq .chezmoi.arch "amd64") (and (hasKey . "roles") (has "docker-engine" .roles))) }}
    # An Intel Mac or a lab node (role docker-engine). Its command-line tools come
    # from mise (decisions 0006, 0026 and 0027 in the vault): on a lab node, a
    # server, because boring wins; on Intel, because Homebrew builds no Intel
    # bottles any more, so a formula upgrade compiles from source for hours.
    # Homebrew keeps the casks, and the few formulae left stay at the versions that
    # work. So bundle installs what is missing without upgrading, and only casks
    # are upgraded.
    if brew update && brew bundle install --global --no-upgrade >"$_bundle" 2>&1; then
      grep -vE '^Using ' "$_bundle" || true
      HOMEBREW_NO_ASK=1 brew upgrade --cask && brew cleanup
{{- else }}
    if brew update && brew bundle install --global >"$_bundle" 2>&1; then
      grep -vE '^Using ' "$_bundle" || true
      # One pass: a bare `brew upgrade` covers formulae AND casks. A second
      # `brew upgrade --cask` found nothing new and only repeated brew's notice
      # about the pinned casks it skips. HOMEBREW_NO_ASK: Homebrew 7's ask mode,
      # on by default in a terminal, stops a bare `brew upgrade` for a yes whenever
      # anything is outdated; running `up` is already that yes.
      HOMEBREW_NO_ASK=1 brew upgrade && brew cleanup
{{- end }}
    else
      command cat "$_bundle"
    fi
    rm -f "$_bundle"
  else
    # Only valid where mise isn't brew-managed. A plain `mise self-update` also
    # updates every installed plugin and prints "plugin:NAME update git repo" for
    # each one on every run, changed or not. So mise first, alone; then the plugins
    # with their output kept back: a plugin is named only when its commit moved,
    # and the output shows only when the update failed.
    mise self-update --no-plugins
    local _mpdir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/plugins"
    local _mp _mpnow _mpout
    local -A _mpsha
    for _mp in "$_mpdir"/*(N/); do
      _mpsha[${_mp:t}]=$(git -C "$_mp" rev-parse --short HEAD 2>/dev/null)
    done
    if (( ${#_mpsha} )); then
      _mpout=$(mise plugins update 2>&1) || print -r -- "$_mpout" >&2
      for _mp in "$_mpdir"/*(N/); do
        _mpnow=$(git -C "$_mp" rev-parse --short HEAD 2>/dev/null)
        if [[ -n "$_mpnow" && "$_mpnow" != "${_mpsha[${_mp:t}]}" ]]; then
          echo "mise plugin:${_mp:t} ${_mpsha[${_mp:t}]:-new} -> $_mpnow"
        fi
      done
    fi
  fi
  # Pinned casks (run_pin-self-updating-casks), the Claude desktop app among them, whose
  # own updater is blocked (run_check-claude-desktop-policy), are skipped by `brew
  # upgrade`. Name the apps that are behind their cask, by the app's own version, so
  # each is updated by choice, at the Mac: cask-update NAME.
  if command -v cask-update &>/dev/null; then
    cask-update --check || true
  fi
  # The Claude desktop app's sign-in lapses after about 30 days, and every session it
  # hosts stops with it: its age, and when it is expected to lapse (claude-signin).
  if command -v claude-signin &>/dev/null; then
    claude-signin || true
  fi
  # `mise upgrade` asks every tool for its latest version, but http:-backend tools
  # pin an exact URL and expose no version feed — they only answer with
  # "Error getting latest version ... no version found". Skip them; they are
  # deliberately version-pinned and get bumped by editing their config entry.
  local _mise_skip=() _t
  while IFS= read -r _t; do [[ -n "$_t" ]] && _mise_skip+=(-x "$_t"); done \
    < <(mise ls --installed --json 2>/dev/null \
        | jq -r 'keys[]? | select(startswith("http:"))' 2>/dev/null)
  # mise sends GITLAB_TOKEN (or MISE_GITLAB_TOKEN) to every GitLab host it downloads
  # from, gitlab.com included, and gitlab.com answers 401 to a token it did not issue,
  # even for a public release: a token kept for another GitLab stops glab's upgrade.
  # What mise fetches here is public, so the upgrade runs without them; a token mise
  # needs for one host goes in ~/.config/mise/gitlab_tokens.toml, which is per host.
  # prune -y: a version no tracked config asks for any more goes without a question,
  # as on linux-minimal; otherwise `up` stopped at a prompt for each one it found.
  ( unset GITLAB_TOKEN MISE_GITLAB_TOKEN
    mise install && mise upgrade "${_mise_skip[@]}" && mise prune -y )
  tools
  # Ghostty, when `up` runs in it: brew quits an app before it upgrades it and opens
  # it again after, but never the app brew itself runs in, so the new Ghostty lands
  # on disk while the open one, every window of it, keeps the old version until it
  # is quit. Ghostty gives its shells its version, TERM_PROGRAM_VERSION: compare it
  # with the installed app's, read from the Info.plist itself (`defaults` can serve
  # a cached copy), and say so on every `up` until Ghostty is reopened. Plain release
  # numbers only (a tip build's version carries its commit), and not over ssh, where
  # Ghostty forwards these variables but this machine's app is not the terminal.
  if [[ ${TERM_PROGRAM:l} == ghostty && -n $TERM_PROGRAM_VERSION && -z $SSH_CONNECTION ]]; then
    local _gh_have=$(plutil -extract CFBundleShortVersionString raw -o - \
      /Applications/Ghostty.app/Contents/Info.plist 2>/dev/null)
    autoload -Uz is-at-least
    if [[ $_gh_have == <->.<->.<-> && $TERM_PROGRAM_VERSION == <->.<->.<-> ]] &&
       ! is-at-least "$_gh_have" "$TERM_PROGRAM_VERSION"; then
      echo "up: Ghostty $_gh_have is installed, but this window runs $TERM_PROGRAM_VERSION: quit Ghostty (Cmd+Q) and reopen it."
    fi
  fi
  echo "up: done — run 'exec zsh' if dotfiles changed"
}

# Tool inventory by category. The categories are not maintained here: they are
# the `# --- ... ---` headers already present in ~/.Brewfile and the mise config,
# read back at runtime, so this can never disagree with what is actually declared
# for installation and a new category needs no change to this function. TOOLS.md
# in the dotfiles repo is the long form — one line per tool with a link, and it
# also covers what the run_ installer scripts add, which these two files cannot
# know about. `up` prints this; run `tools` any time to see it on its own.
# One rule does live here: a command-line category is one line, whichever of the
# two files declares its tools. The Brewfile's "Formulae: " prefix is dropped and
# names compare without case, so its "kubernetes / cloud-native" and the mise
# config's "Kubernetes / cloud-native" count together, and the line says how many
# come from each when both supply some. Casks are apps, not commands: their
# "Casks: " groups stay apart and print last.
tools() {
  local -a _cfg
  _cfg=( ~/.Brewfile(N) ~/.config/mise/config.toml(N) )
  (( $#_cfg )) || { echo "tools: no Brewfile or mise config found" >&2; return 1 }
  awk '
    FNR == 1 { cat = "" }
    /^#[[:space:]]*---/ {
      line = $0
      sub(/^#[[:space:]]*---[[:space:]]*/, "", line)
      sub(/[[:space:]]*---[[:space:]]*$/, "", line)
      app = (line ~ /^Casks:/)
      if (!app) {
        sub(/^Formulae:[[:space:]]*/, "", line)
        line = toupper(substr(line, 1, 1)) substr(line, 2)
      }
      cat = tolower(line)
      if (!(cat in label)) { label[cat] = line; isapp[cat] = app; order[++k] = cat }
      next
    }
    cat == "" { next }
    /^(brew|cask)[[:space:]]+"/ { n[cat]++; nbrew[cat]++; next }
    /^"?[A-Za-z0-9_.:@\/+-]+"?[[:space:]]*=[[:space:]]*[{"]/ { n[cat]++; nmise[cat]++ }
    END {
      for (pass = 0; pass <= 1; pass++)
        for (i = 1; i <= k; i++) {
          c = order[i]
          if (isapp[c] != pass || n[c] == 0) continue
          total += n[c]
          if (nbrew[c] && nmise[c])
            printf "  %-38s %3d  (%d brew, %d mise)\n", label[c], n[c], nbrew[c], nmise[c]
          else
            printf "  %-38s %3d\n", label[c], n[c]
        }
      printf "  %-38s %3d\n", "total (brew/mise)", total
    }
  ' "${_cfg[@]}"
  echo "  + whatever the run_ installers add on this machine — see TOOLS.md"
}

# --- Network / misc ---
alias ssh0='ssh -q -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
alias myip4='curl -s https://api4.ipify.org'
alias myip6='curl -s https://api6.ipify.org'
alias digmyip='dig +short myip.opendns.com @resolver1.opendns.com'

# === Role and machine-local shell fragments ===
# Two layers, both sourced here — after the core aliases/compdefs, before
# syntax-highlighting — so either can extend or override what is above.
# (N) null-glob: no error when a dir is empty or absent; -r skips dangling links.
#
# role.d: what this MACHINE DOES, from the `roles` list in the chezmoi config.
# chezmoi drops a role's file on machines without that role, so this loop is
# usually empty. Sourced FIRST, so local.d below still wins over it.
for _f in ~/.config/zsh/role.d/*.zsh(N); do [[ -r "$_f" ]] && source "$_f"; done
unset _f

# local.d: per-machine private override, layered in by the private overlay's
# install.sh (work aliases, functions, completions). Never chezmoi-managed.
for _f in ~/.config/zsh/local.d/*.zsh(N); do [[ -r "$_f" ]] && source "$_f"; done
unset _f

# === Plugins that must load last ===
# zsh-syntax-highlighting must be sourced AFTER all compdef/alias definitions.
[[ -f "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# zsh-history-substring-search must load AFTER syntax-highlighting.
if [[ -f "$ZSH_PLUGIN_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh" ]]; then
  source "$ZSH_PLUGIN_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh"
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
